From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kaiyin Zhong <kaiyin@zhong.science>
Date: Wed, 11 Nov 2026 14:19:53 +0100
Subject: [PATCH] egl/dri2: don't report dmabuf export of images the driver
 can't share

dri2_export_dma_buf_image_mesa() ignored the result of the
__DRI_IMAGE_ATTRIB_FD query and returned EGL_TRUE with fds[0] left as it
was. d3d12 can only export resources created shareable, so exporting a GL
texture 'succeeded' with no fd: GTK 4 then built a dmabuf texture from an
uninitialized fd every frame (GtkGLArea: 'planes[0].fd > 0' assertion; a
GSK render_texture came back empty and GTK closed a garbage fd number).

- Export: fail with EGL_BAD_ALLOC (closing fds already obtained) when an
  fd can't be had.
- Query: report an image as exportable only if the driver can give an fd
  for it, so callers fall back quietly instead of failing every frame.

Generated-by: LLM
---
 src/egl/drivers/dri2/egl_dri2.c | 26 +++++++++++++++++++++++---
 1 file changed, 23 insertions(+), 3 deletions(-)

diff --git a/src/egl/drivers/dri2/egl_dri2.c b/src/egl/drivers/dri2/egl_dri2.c
index edee4ff..ce512dd 100644
--- a/src/egl/drivers/dri2/egl_dri2.c
+++ b/src/egl/drivers/dri2/egl_dri2.c
@@ -2525,6 +2525,14 @@ dri2_can_export_dma_buf_image(_EGLDisplay *disp, _EGLImage *img)
       return false;
    }
 
+   /* Having a format doesn't mean the driver can share the image: d3d12 can only export resources
+    * that were created shareable. Report that here, so that callers (GTK) fall back quietly instead
+    * of failing eglExportDMABUFImageMESA on every frame. */
+   int fd;
+   if (!dri2_query_image(dri2_img->dri_image, __DRI_IMAGE_ATTRIB_FD, &fd))
+      return false;
+   close(fd);
+
    return true;
 }
 
@@ -2607,10 +2615,22 @@ dri2_export_dma_buf_image_mesa(_EGLDisplay *disp, _EGLImage *img, int *fds,
           *    "If the number of fds is less than the number of planes, then
           *    subsequent fd slots should contain -1."
           */
-         if (i == 0 || is_disjoint)
-            dri2_query_image(image, __DRI_IMAGE_ATTRIB_FD, &fds[i]);
-         else
+         if (i == 0 || is_disjoint) {
+            /* A driver may be unable to export this image (d3d12 can only share resources created
+             * shareable). Fail instead of returning success with fds[i] left unset. */
+            if (!dri2_query_image(image, __DRI_IMAGE_ATTRIB_FD, &fds[i])) {
+               if (i)
+                  dri2_destroy_image(image);
+               for (int j = 0; j < i; j++) {
+                  if (fds[j] >= 0)
+                     close(fds[j]);
+               }
+               mtx_unlock(&dri2_dpy->lock);
+               return _eglError(EGL_BAD_ALLOC, "eglExportDMABUFImageMESA");
+            }
+         } else {
             fds[i] = -1;
+         }
       }
 
       if (strides && !dri2_query_image(image, __DRI_IMAGE_ATTRIB_STRIDE, &strides[i]))
