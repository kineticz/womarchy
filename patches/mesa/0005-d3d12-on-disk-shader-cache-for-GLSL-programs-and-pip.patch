+/* Driver-compiled pipeline states (ID3D12PipelineState::GetCachedBlob) in the screen's disk cache. Every
+ * new process otherwise has the GPU driver compile all of its pipelines again (on WSL with Intel, IGC:
+ * hundreds of ms for a GTK window's first frame). The key covers the whole pipeline description; the
+ * runtime and driver also validate a cached blob against the description and driver version, and a
+ * rejected blob just means compiling as before. */
+static void
+hash_bytecode(struct mesa_blake3 *c, const D3D12_SHADER_BYTECODE &b)
+{
+   _mesa_blake3_update(c, &b.BytecodeLength, sizeof(b.BytecodeLength));
+   if (b.pShaderBytecode)
+      _mesa_blake3_update(c, b.pShaderBytecode, b.BytecodeLength);
+}
+
+static void
+hash_string(struct mesa_blake3 *c, const char *str)
+{
+   if (str)
+      _mesa_blake3_update(c, str, strlen(str) + 1);
+   else
+      _mesa_blake3_update(c, "", 1);
+}
+
+static bool
+root_signature_key_for(struct d3d12_context *ctx, ID3D12RootSignature *sig,
+                       struct d3d12_root_signature_key *key)
+{
+   hash_table_foreach(ctx->root_signature_cache, entry) {
+      if (d3d12_root_signature_from_entry(entry) == sig) {
+         memcpy(key, entry->key, sizeof(*key));
+         return true;
+      }
+   }
+   return false;
+}
+
+static ID3D12PipelineState *
+create_gfx_pso_cached(struct d3d12_context *ctx, struct d3d12_screen *screen,
+                      CD3DX12_PIPELINE_STATE_STREAM3 &pso_desc, HRESULT *phr);
+
 static ID3D12PipelineState *
 create_gfx_pipeline_state(struct d3d12_context *ctx)
 {
@@ -407,30 +450,136 @@ create_gfx_pipeline_state(struct d3d12_context *ctx)
 
    pso_desc.Flags = D3D12_PIPELINE_STATE_FLAG_NONE;
 
-   ID3D12PipelineState *ret;
-
    HRESULT hr;
+   ID3D12PipelineState *ret = create_gfx_pso_cached(ctx, screen, pso_desc, &hr);
+   if (!ret) {
+      std::_Exit(hr);
+      return NULL;
+   }
+   return ret;
+}
+
+static HRESULT
+create_gfx_pso(struct d3d12_screen *screen, CD3DX12_PIPELINE_STATE_STREAM3 &pso_desc,
+               ID3D12PipelineState **ret)
+{
    if (screen->opts14.IndependentFrontAndBackStencilRefMaskSupported) {
       D3D12_PIPELINE_STATE_STREAM_DESC pso_stream_desc{
           sizeof(pso_desc),
           &pso_desc
       };
+      return screen->dev->CreatePipelineState(&pso_stream_desc, IID_PPV_ARGS(ret));
+   }
+   D3D12_GRAPHICS_PIPELINE_STATE_DESC v0desc = pso_desc.GraphicsDescV0();
+   return screen->dev->CreateGraphicsPipelineState(&v0desc, IID_PPV_ARGS(ret));
+}
 
-      if (FAILED(hr = screen->dev->CreatePipelineState(&pso_stream_desc,
-                                                       IID_PPV_ARGS(&ret)))) {
-         std::_Exit(hr);
-         return NULL;
-      }
-   } 
-   else {
-      D3D12_GRAPHICS_PIPELINE_STATE_DESC v0desc = pso_desc.GraphicsDescV0();
-      if (FAILED(hr = screen->dev->CreateGraphicsPipelineState(&v0desc,
-                                                               IID_PPV_ARGS(&ret)))) {
