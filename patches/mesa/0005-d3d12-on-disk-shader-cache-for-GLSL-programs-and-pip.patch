-         return NULL;
+static bool
+gfx_pso_cache_key(struct d3d12_context *ctx, struct disk_cache *cache,
+                  CD3DX12_PIPELINE_STATE_STREAM3 &d, cache_key key)
+{
+   struct d3d12_root_signature_key rs_key;
+   if (!root_signature_key_for(ctx, d.pRootSignature, &rs_key))
+      return false;
+
+   struct mesa_blake3 c;
+   _mesa_blake3_init(&c);
+   _mesa_blake3_update(&c, &rs_key, sizeof(rs_key));
+   hash_bytecode(&c, d.VS);
+   hash_bytecode(&c, d.HS);
+   hash_bytecode(&c, d.DS);
+   hash_bytecode(&c, d.GS);
+   hash_bytecode(&c, d.PS);
+
+   const D3D12_STREAM_OUTPUT_DESC &so = d.StreamOutput;
+   _mesa_blake3_update(&c, &so.NumEntries, sizeof(so.NumEntries));
+   for (UINT i = 0; i < so.NumEntries; i++) {
+      const D3D12_SO_DECLARATION_ENTRY &e = so.pSODeclaration[i];
+      hash_string(&c, e.SemanticName);
+      UINT v[5] = { e.Stream, e.SemanticIndex, e.StartComponent, e.ComponentCount, e.OutputSlot };
+      _mesa_blake3_update(&c, v, sizeof(v));
+   }
+   _mesa_blake3_update(&c, &so.NumStrides, sizeof(so.NumStrides));
+   if (so.NumStrides)
+      _mesa_blake3_update(&c, so.pBufferStrides, so.NumStrides * sizeof(UINT));
+   _mesa_blake3_update(&c, &so.RasterizedStream, sizeof(so.RasterizedStream));
+
+   const D3D12_BLEND_DESC &blend = d.BlendState;
+   _mesa_blake3_update(&c, &blend, sizeof(blend));
+   const d3d12_depth_stencil_desc_type &zsa = d.DepthStencilState;
+   _mesa_blake3_update(&c, &zsa, sizeof(zsa));
+   UINT sample_mask = d.SampleMask;
+   _mesa_blake3_update(&c, &sample_mask, sizeof(sample_mask));
+   const D3D12_RASTERIZER_DESC &rast = d.RasterizerState;
+   _mesa_blake3_update(&c, &rast, sizeof(rast));
+
+   const D3D12_INPUT_LAYOUT_DESC &il = d.InputLayout;
+   _mesa_blake3_update(&c, &il.NumElements, sizeof(il.NumElements));
+   for (UINT i = 0; i < il.NumElements; i++) {
+      const D3D12_INPUT_ELEMENT_DESC &e = il.pInputElementDescs[i];
+      hash_string(&c, e.SemanticName);
+      UINT v[6] = { e.SemanticIndex, (UINT)e.Format, e.InputSlot, e.AlignedByteOffset,
+                    (UINT)e.InputSlotClass, e.InstanceDataStepRate };
+      _mesa_blake3_update(&c, v, sizeof(v));
+   }
+
+   D3D12_INDEX_BUFFER_STRIP_CUT_VALUE cut = d.IBStripCutValue;
+   D3D12_PRIMITIVE_TOPOLOGY_TYPE topo = d.PrimitiveTopologyType;
+   const D3D12_RT_FORMAT_ARRAY &rts = d.RTVFormats;
+   DXGI_FORMAT dsv = d.DSVFormat;
+   const DXGI_SAMPLE_DESC &samples = d.SampleDesc;
+   D3D12_PIPELINE_STATE_FLAGS flags = d.Flags;
+   _mesa_blake3_update(&c, &cut, sizeof(cut));
+   _mesa_blake3_update(&c, &topo, sizeof(topo));
+   _mesa_blake3_update(&c, &rts, sizeof(rts));
+   _mesa_blake3_update(&c, &dsv, sizeof(dsv));
+   _mesa_blake3_update(&c, &samples, sizeof(samples));
+   _mesa_blake3_update(&c, &flags, sizeof(flags));
+
+   blake3_hash h;
+   _mesa_blake3_final(&c, h);
+   disk_cache_compute_key(cache, h, sizeof(h), key);
+   return true;
+}
+
+static ID3D12PipelineState *
+create_gfx_pso_cached(struct d3d12_context *ctx, struct d3d12_screen *screen,
+                      CD3DX12_PIPELINE_STATE_STREAM3 &pso_desc, HRESULT *phr)
+{
+   ID3D12PipelineState *ret = NULL;
+   struct disk_cache *cache = screen->disk_cache;
+   cache_key key;
+   bool have_key = cache && gfx_pso_cache_key(ctx, cache, pso_desc, key);
+
+   if (have_key) {
+      size_t size = 0;
+      void *blob = disk_cache_get(cache, key, &size);
+      if (blob) {
+         D3D12_CACHED_PIPELINE_STATE &cached = (D3D12_CACHED_PIPELINE_STATE &)pso_desc.CachedPSO;
+         cached.pCachedBlob = blob;
+         cached.CachedBlobSizeInBytes = size;
+         HRESULT hr = create_gfx_pso(screen, pso_desc, &ret);
+         cached.pCachedBlob = NULL;
+         cached.CachedBlobSizeInBytes = 0;
+         free(blob);
+         if (SUCCEEDED(hr))
+            return ret;
+         ret = NULL;   /* stale or mismatched blob: compile, and replace it below */
       }
    }
 
+   *phr = create_gfx_pso(screen, pso_desc, &ret);
+   if (FAILED(*phr))
+      return NULL;
+
+   if (have_key) {
+      ID3DBlob *blob = NULL;
+      if (SUCCEEDED(ret->GetCachedBlob(&blob)) && blob) {
+         if (blob->GetBufferSize())
+            disk_cache_put(cache, key, blob->GetBufferPointer(), blob->GetBufferSize(), NULL);
+         blob->Release();
+      }
+   }
    return ret;
 }
 
