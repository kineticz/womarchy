+/* Without a shader cache, every process links all of its GLSL programs and has the GPU driver compile
+ * all of its pipelines again: on WSL a GTK window's first frame took ~1.5 s. The cache identity covers
+ * this Mesa build, the adapter and its driver version, and the debug flags that change shader output. */
+static void
+d3d12_disk_cache_init(struct d3d12_screen *screen)
+{
+#if defined(ENABLE_SHADER_CACHE) && HAVE_BUILD_ID
+   const struct build_id_note *note = build_id_find_nhdr_for_addr((void *)d3d12_disk_cache_init);
+   if (!note)
+      return;
+   struct mesa_blake3 ctx;
+   _mesa_blake3_init(&ctx);
+   _mesa_blake3_update(&ctx, build_id_data(note), build_id_length(note));
+   _mesa_blake3_update(&ctx, &screen->vendor_id, sizeof(screen->vendor_id));
+   _mesa_blake3_update(&ctx, &screen->device_id, sizeof(screen->device_id));
+   _mesa_blake3_update(&ctx, &screen->revision, sizeof(screen->revision));
+   _mesa_blake3_update(&ctx, &screen->driver_version, sizeof(screen->driver_version));
+   _mesa_blake3_update(&ctx, &d3d12_debug, sizeof(d3d12_debug));
+   blake3_hash id;
+   _mesa_blake3_final(&ctx, id);
+   char id_hex[BLAKE3_HEX_LEN];
+   mesa_bytes_to_hex(id_hex, id, BLAKE3_KEY_LEN);
+   screen->disk_cache = disk_cache_create("d3d12", id_hex, 0);
+#endif
+}
+
+static struct disk_cache *
+d3d12_get_disk_shader_cache(struct pipe_screen *pscreen)
+{
+   return d3d12_screen(pscreen)->disk_cache;
+}
+
 static void
 d3d12_flush_frontbuffer(struct pipe_screen * pscreen,
                         struct pipe_context *pctx,
@@ -1874,5 +1910,8 @@ d3d12_init_screen(struct d3d12_screen *screen, IUnknown *adapter)
    d3d12_init_compute_caps(screen);
    d3d12_init_screen_caps(screen);
 
+   d3d12_disk_cache_init(screen);
+   screen->base.get_disk_shader_cache = d3d12_get_disk_shader_cache;
+
    return true;
 }
