# Speakers and microphone for the session, backed by Windows through omarchy.exe (see womarchy-mediad.c).
# Started with the graphical session that uwsm brings up; only in sessions launched by an omarchy.exe
# that has the media channel (it sets WOMARCHY_MEDIA_TOKEN). Older viewers keep WSLg's audio path.
[Unit]
Description=womarchy media bridge (PipeWire <-> Windows audio)
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service
Requisite=graphical-session.target
Wants=pipewire.service wireplumber.service
ConditionEnvironment=WOMARCHY_MEDIA_TOKEN

[Service]
ExecStart=/usr/bin/womarchy-mediad
Restart=on-failure
RestartSec=1
Slice=session.slice
