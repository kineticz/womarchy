From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kaiyin Zhong <kaiyin@zhong.science>
Date: Wed, 11 Nov 2026 15:37:55 +0100
Subject: [PATCH 9/9] microsoft/compiler: compare against infinity with ordered
 comparisons

Intel's D3D12 driver (Iris Xe, WSL) miscompiles an equality test of a
computed value against the constant infinity: abs(x) == inf, x * 2.0 == inf
and isinf(x) (which NIR lowers to the former) are always false, and
abs(x) != inf always true. A raw input compared with inf, a comparison with
infinity from a uniform, and ordered comparisons (abs(x) >= inf) work.

Skia's tessellation shaders mark curve types with inf in their instance
data (abs(p23.z) == inf), so Chromium/Edge drew wrong triangle fans for
every rounded path it stencils: crosses over buttons with a rounded border
and a broken 'e' in the Google logo.

Emit x == +inf as x >= +inf and x != +inf as !(x >= +inf) (unordered less
than), and the same for -inf. Both are equal for every x, NaN included.

Generated-by: LLM
---
 src/microsoft/compiler/nir_to_dxil.c | 49 ++++++++++++++++++++++++++--
 1 file changed, 47 insertions(+), 2 deletions(-)

diff --git a/src/microsoft/compiler/nir_to_dxil.c b/src/microsoft/compiler/nir_to_dxil.c
index d8522a1..aa28446 100644
--- a/src/microsoft/compiler/nir_to_dxil.c
+++ b/src/microsoft/compiler/nir_to_dxil.c
@@ -2282,6 +2282,51 @@ emit_binop(struct ntd_context *ctx, nir_alu_instr *alu,
    return true;
 }
 
+static bool
+emit_cmp(struct ntd_context *ctx, nir_alu_instr *alu,
+         enum dxil_cmp_pred pred,
+         const struct dxil_value *op0, const struct dxil_value *op1);
+
+/* If one source of a float comparison is the constant +inf or -inf, return its index and sign. */
+static bool
+cmp_src_is_inf(nir_alu_instr *alu, unsigned *idx, bool *positive)
+{
+   for (unsigned i = 0; i < 2; i++) {
+      if (!nir_src_is_const(alu->src[i].src))
+         continue;
+      double v = nir_src_comp_as_float(alu->src[i].src, alu->src[i].swizzle[0]);
+      if (isinf(v)) {
+         *idx = i;
+         *positive = v > 0;
+         return true;
+      }
+   }
+   return false;
+}
+
+/* x == inf and x != inf as x >= inf and !(x >= inf), which are the same for every x (NaN included).
+ * Some drivers miscompile an equality test of a computed value against the constant infinity
+ * (Intel's D3D12 driver: abs(x) == inf and x * 2.0 == inf are always false), while ordered
+ * comparisons against it work. Skia's tessellation shaders mark curve types with inf this way. */
+static bool
+emit_inf_cmp(struct ntd_context *ctx, nir_alu_instr *alu, bool eq,
+             const struct dxil_value *op0, const struct dxil_value *op1)
+{
+   unsigned idx;
+   bool positive;
+   if (!cmp_src_is_inf(alu, &idx, &positive))
+      return emit_cmp(ctx, alu, eq ? DXIL_FCMP_OEQ : DXIL_FCMP_UNE, op0, op1);
+
+   const struct dxil_value *x = idx == 0 ? op1 : op0;
+   const struct dxil_value *inf = idx == 0 ? op0 : op1;
+   enum dxil_cmp_pred pred;
+   if (eq)
+      pred = positive ? DXIL_FCMP_OGE : DXIL_FCMP_OLE;
+   else
+      pred = positive ? DXIL_FCMP_ULT : DXIL_FCMP_UGT;
+   return emit_cmp(ctx, alu, pred, x, inf);
+}
+
 static bool
 emit_shift(struct ntd_context *ctx, nir_alu_instr *alu,
            enum dxil_bin_opcode opcode,
@@ -2949,8 +2994,8 @@ emit_alu(struct ntd_context *ctx, nir_alu_instr *alu)
    case nir_op_uge:  return emit_cmp(ctx, alu, DXIL_ICMP_UGE, src[0], src[1]);
    case nir_op_ilt:  return emit_cmp(ctx, alu, DXIL_ICMP_SLT, src[0], src[1]);
    case nir_op_ult:  return emit_cmp(ctx, alu, DXIL_ICMP_ULT, src[0], src[1]);
-   case nir_op_feq:  return emit_cmp(ctx, alu, DXIL_FCMP_OEQ, src[0], src[1]);
-   case nir_op_fneu: return emit_cmp(ctx, alu, DXIL_FCMP_UNE, src[0], src[1]);
+   case nir_op_feq:  return emit_inf_cmp(ctx, alu, true, src[0], src[1]);
+   case nir_op_fneu: return emit_inf_cmp(ctx, alu, false, src[0], src[1]);
    case nir_op_flt:  return emit_cmp(ctx, alu, DXIL_FCMP_OLT, src[0], src[1]);
    case nir_op_fge:  return emit_cmp(ctx, alu, DXIL_FCMP_OGE, src[0], src[1]);
    case nir_op_ftrunc: return emit_unary_intin(ctx, alu, DXIL_INTR_ROUND_Z, src[0]);
