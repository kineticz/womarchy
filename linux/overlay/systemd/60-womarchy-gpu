#!/bin/sh
# womarchy: systemd user environment generator (/usr/lib/systemd/user-environment-generators).
# Selects Mesa's d3d12 driver for the user manager (and so uwsm, Hyprland and every
# user service) only when WSL exposes the host GPU as /dev/dxg. Mesa does not fall
# back once GALLIUM_DRIVER is set, so without /dev/dxg it stays unset (llvmpipe).
# A value already in the manager's environment (environment.d, an import) wins.
# WOMARCHY_DXG overrides the device path, WOMARCHY_DRM_SYSFS the DRM class dir (tests).
dxg=${WOMARCHY_DXG:-/dev/dxg}
sysfs=${WOMARCHY_DRM_SYSFS:-/sys/class/drm}
d3d12=
if [ -z "${GALLIUM_DRIVER+x}" ] && [ -e "$dxg" ]; then
  echo GALLIUM_DRIVER=d3d12
  d3d12=1
fi
# GTK4: the GL renderer (works on d3d12 and llvmpipe); its Vulkan path would run on
# the non-conformant Dozen driver.
if [ -z "${GSK_RENDERER+x}" ]; then
  echo GSK_RENDERER=gl
fi

# Zero-copy GPU buffers (docs/research/06-zero-copy-gpu-buffers.md). Newer WSL kernels have
# vgem built in; on its render node GBM/EGL run d3d12 and apps hand frames to Hyprland over
# linux-dmabuf instead of reading them back into shared memory. Opt out: WOMARCHY_DMABUF=0
# in ~/.config/environment.d/*.conf.
[ -n "$d3d12" ] && [ "${WOMARCHY_DMABUF:-1}" != 0 ] || exit 0
node=
for n in "$sysfs"/renderD*; do
  [ -e "$n" ] || continue
  case "$(readlink -f "$n/device")" in
    */vgem) node=/dev/dri/${n##*/}; break ;;
  esac
done
[ -n "$node" ] || exit 0
echo WOMARCHY_DMABUF=1
echo WOMARCHY_RENDER_NODE="$node"
# Mesa's Wayland/X11 loaders look for a driver named after the device ("vgem") and would fall
# back to wl_shm; kms_swrast runs GALLIUM_DRIVER (d3d12) on the node.
[ -n "${MESA_LOADER_DRIVER_OVERRIDE+x}" ] || echo MESA_LOADER_DRIVER_OVERRIDE=kms_swrast
# Xwayland then offers DRI3, where GLX can't load kms_swrast and falls back to zink (Vulkan on
# Dozen), which crashes; without zink GLX uses its software winsys running d3d12, as before.
[ -n "${LIBGL_KOPPER_DISABLE+x}" ] || echo LIBGL_KOPPER_DISABLE=1
