# womarchy (Omarchy on WSL) session environment, sourced by uwsm before Hyprland
# starts (after Omarchy's /usr/share/uwsm/env.d/10-omarchy). Managed by
# womarchy-provision-user; put personal additions in another env.d file.

# GPU: GALLIUM_DRIVER=d3d12 (only with /dev/dxg) and GSK_RENDERER=gl come from
# the 60-womarchy-gpu user environment generator, i.e. from the user manager's
# environment, which uwsm starts from.

# Ignore WSL's PULSE_SERVER so clients use the default local PipeWire socket
# ($XDG_RUNTIME_DIR/pulse/native). WebKitGTK 2.54.1 aborts when its sandbox
# parses an explicit unix: address; without it, WebKit binds the default socket.
unset PULSE_SERVER

# WSL fallbacks for tools of hardware WSL lacks (e.g. nm-online, so Omarchy's
# first run does not ask to set up Wi-Fi). Appended: real tools always win.
case ":$PATH:" in
  *:/usr/lib/womarchy/bin:*) ;;
  *) export PATH="$PATH:/usr/lib/womarchy/bin" ;;
esac
